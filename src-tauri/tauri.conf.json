{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "vue3-starter",
  "version": "0.1.0",
  "identifier": "com.vue-bun.vue3starter",
  "build": {
    "frontendDist": "../dist",
    "devUrl": null,
    "beforeDevCommand": "bun run start",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "vue3-starter",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["../dist/**/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "developmentTeam": "DA9798GQ27"
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
